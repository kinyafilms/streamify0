# Infrastructure (Local Dev defaults are provided)
REDIS_HOST=localhost
REDIS_PORT=6379
DATABASE_URL="postgresql://postgres:password@localhost:5432/streamify?schema=public"

# S3 / Cloudflare R2 / MinIO Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=streamify
S3_BUCKET_NAME=streamify
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Frontend Public URLs (Update for Production)
NEXT_PUBLIC_S3_URL=http://localhost:9000/streamify
